ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://dst_orchestrator:REPLACE_ME@127.0.0.1/dst_orchestrator
RUNTIME_PROVIDER=incus
DST_FARM_SECRET_KEY=REPLACE_WITH_FERNET_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
ORCHESTRATOR_PUBLIC_URL=https://orchestrator.example.com
INCUS_REMOTE=local
INCUS_BASE_INSTANCE=dst-base-v1
CURRENT_IMAGE_VERSION=dst-base-v1
# Keep false until the named image has passed the real Linux/Incus validation.
CURRENT_IMAGE_VERIFIED=false
RUNTIME_DISPLAY=:99
# RUNTIME_XAUTHORITY=/run/dst-runtime/Xauthority
RUNTIME_WORKER_PLUGIN=dst
RUNTIME_AUTO_LAUNCH_STEAM=false
RUNTIME_AUTO_LAUNCH_DST=false
# RUNTIME_STEAM_COMMAND=/opt/dst-runtime/bin/launch-steam
# RUNTIME_DST_COMMAND=/opt/dst-runtime/bin/launch-dst
RUNTIME_DISPLAY_READINESS_TIMEOUT_SECONDS=15
RUNTIME_STEAM_READINESS_TIMEOUT_SECONDS=120
RUNTIME_DST_READINESS_TIMEOUT_SECONDS=300
DEFAULT_NODE_NAME=node-01
DEFAULT_NODE_MAX_ACTIVE_SLOTS=4
AUTO_MIGRATE=false
