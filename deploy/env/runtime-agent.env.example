CONTROL_PLANE_URL=https://orchestrator.example.com
ACCOUNT_ID=1
RUNTIME_ID=1
NODE_ID=1
RUNTIME_TOKEN=REPLACE_WITH_ONE_TIME_ROTATED_RUNTIME_TOKEN
RUNTIME_AGENT_VERSION=1.0.0
AGENT_PROTOCOL_VERSION=1
DISPLAY_BACKEND=xvfb
DISPLAY=:99
XDG_RUNTIME_DIR=/run/user/1000
XVFB_COMMAND=Xvfb :99 -screen 0 1280x720x24 -nolisten tcp
AUTO_LAUNCH_STEAM=0
AUTO_LAUNCH_DST=0
PROCESS_MAX_RESTARTS=3
PROCESS_RESTART_BACKOFF_SECONDS=2
WORKER_PLUGIN=noop
# Linux systemd/Xvfb/Steam/DST behavior remains UNVALIDATED_ON_REAL_NODE.
