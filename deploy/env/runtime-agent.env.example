CONTROL_PLANE_URL=https://orchestrator.example.com
ACCOUNT_ID=1
RUNTIME_ID=1
RUNTIME_GENERATION=1
NODE_ID=1
RUNTIME_TOKEN=REPLACE_WITH_ONE_TIME_ROTATED_RUNTIME_TOKEN
RUNTIME_AGENT_VERSION=1.0.0
AGENT_PROTOCOL_VERSION=1
DISPLAY_BACKEND=xvfb
DISPLAY=:99
# If set, XVFB_COMMAND must use the same file with -auth.
# XAUTHORITY=/run/dst-runtime/Xauthority
XDG_RUNTIME_DIR=/run/dst-runtime
XVFB_COMMAND=Xvfb :99 -screen 0 1280x720x24 -nolisten tcp
AUTO_LAUNCH_STEAM=0
AUTO_LAUNCH_DST=0
# Auto-launch requires readiness-aware, foreground launchers; the defaults are
# intentionally rejected when auto-launch is enabled.
# STEAM_COMMAND=/opt/dst-runtime/bin/launch-steam
# DST_COMMAND=/opt/dst-runtime/bin/launch-dst
DISPLAY_READINESS_TIMEOUT_SECONDS=15
STEAM_READINESS_TIMEOUT_SECONDS=120
DST_READINESS_TIMEOUT_SECONDS=300
PROCESS_MAX_RESTARTS=3
PROCESS_RESTART_BACKOFF_SECONDS=2
WORKER_PLUGIN=noop
WORKER_ACTION_QUEUE_SIZE=16
WORKER_INPUT_SUBPROCESS_TIMEOUT=2
WORKER_CAPTURE_BACKEND=x11
WORKER_CAPTURE_TIMEOUT=2
WORKER_MAX_FRAME_AGE=3
WORKER_PERCEPTION_TIMEOUT=1
WORKER_MAX_OBSERVATION_AGE=3
WORKER_PLANNER_TIMEOUT=0.5
WORKER_CAPTURE_MAX_WIDTH=1280
WORKER_CAPTURE_MAX_HEIGHT=720
# Set only after the exact real DST display profile has been reviewed.
WORKER_CALIBRATION_VERIFIED=false
WORKER_RECORDING_ENABLED=false
WORKER_RECORDING_ROOT=/home/dst/.local/state/dst-runtime/worker-recordings
WORKER_RECORDING_MAX_DURATION=900
WORKER_RECORDING_MAX_FRAMES=1800
WORKER_RECORDING_MAX_BYTES=536870912
WORKER_RECORDING_QUEUE_SIZE=8
WORKER_RECORDING_FRAME_INTERVAL=0.5
WORKER_RECORDING_SHUTDOWN_TIMEOUT=5
# WORKER_REPLAY_SESSION_PATH=/home/dst/.local/state/dst-runtime/worker-recordings/<session-id>
WORKER_REPLAY_TIMING_MODE=AS_FAST_AS_POSSIBLE
# Linux systemd/Xvfb/Steam/DST behavior remains UNVALIDATED_ON_REAL_NODE.
