[Unit]
Description=DST runtime control plane
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=dst-orchestrator
Group=dst-orchestrator
WorkingDirectory=/opt/dst-orchestrator
EnvironmentFile=/etc/dst-orchestrator/control-plane.env
Environment=INCUS_CONF=/var/lib/dst-orchestrator/incus
ExecStartPre=/opt/dst-orchestrator/.venv/bin/alembic upgrade head
ExecStart=/opt/dst-orchestrator/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dst-orchestrator
UMask=0077

[Install]
WantedBy=multi-user.target
