ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8080
DATABASE_URL=sqlite:///.data/dst_orchestrator.sqlite3
RUNTIME_PROVIDER=mock
RUNTIME_VIEW_PROVIDER=disabled
VIEW_SESSION_TTL_SECONDS=300
RUNTIME_DISPLAY=:99
# Optional absolute Xauthority file; bootstrap generates a matching Xvfb command.
# RUNTIME_XAUTHORITY=/run/dst-runtime/Xauthority

# Runtime-agent defaults are safe: automation is off until explicitly enabled.
WORKER_PLUGIN=noop
WORKER_MODE=DISABLED
WORKER_AUTOSTART=0
WORKER_CONFIG_SCHEMA_VERSION=1
WORKER_ACTION_QUEUE_SIZE=16
WORKER_INPUT_SUBPROCESS_TIMEOUT=2
WORKER_CAPTURE_BACKEND=x11
WORKER_CAPTURE_TIMEOUT=2
WORKER_MAX_FRAME_AGE=3
WORKER_PERCEPTION_TIMEOUT=1
WORKER_MAX_OBSERVATION_AGE=3
WORKER_PLANNER_TIMEOUT=0.5
WORKER_CAPTURE_MAX_WIDTH=1280
WORKER_CAPTURE_MAX_HEIGHT=720
# Remains false until a real DST host/profile is calibrated and reviewed.
WORKER_CALIBRATION_VERIFIED=false
WORKER_RECORDING_ENABLED=false
WORKER_RECORDING_ROOT=/home/dst/.local/state/dst-runtime/worker-recordings
WORKER_RECORDING_MAX_DURATION=900
WORKER_RECORDING_MAX_FRAMES=1800
WORKER_RECORDING_MAX_BYTES=536870912
WORKER_RECORDING_QUEUE_SIZE=8
WORKER_RECORDING_FRAME_INTERVAL=0.5
WORKER_RECORDING_SHUTDOWN_TIMEOUT=5
# Required only when WORKER_MODE=REPLAY. Must name a validated session directory.
# WORKER_REPLAY_SESSION_PATH=/home/dst/.local/state/dst-runtime/worker-recordings/<session-id>
WORKER_REPLAY_TIMING_MODE=AS_FAST_AS_POSSIBLE
RUNTIME_WORKER_PLUGIN=dst
RUNTIME_AUTO_LAUNCH_STEAM=false
RUNTIME_AUTO_LAUNCH_DST=false
# Required when the matching auto-launch flag is enabled. Launchers must remain
# attached to the managed process and create the configured readiness marker.
# RUNTIME_STEAM_COMMAND=/opt/dst-runtime/bin/launch-steam
# RUNTIME_DST_COMMAND=/opt/dst-runtime/bin/launch-dst
RUNTIME_DISPLAY_READINESS_TIMEOUT_SECONDS=15
RUNTIME_STEAM_READINESS_TIMEOUT_SECONDS=120
RUNTIME_DST_READINESS_TIMEOUT_SECONDS=300

# Generate a Fernet key with cryptography; dev creates .data/dev_master.key if empty.
DST_FARM_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123
SESSION_TTL_SECONDS=28800
DEBUG=false
AUTO_MIGRATE=true

INCUS_REMOTE=local
INCUS_BASE_INSTANCE=dst-base-v1
CURRENT_IMAGE_VERSION=dst-base-v1
INCUS_IMAGE=images:ubuntu/24.04
INCUS_PROFILE=default
INCUS_COMMAND_TIMEOUT_SECONDS=90
INCUS_MAX_ATTEMPTS=3

DEFAULT_NODE_NAME=local-node
DEFAULT_NODE_MAX_ACTIVE_SLOTS=2
DEFAULT_NODE_SECRET=

JOB_POLL_INTERVAL_SECONDS=1
JOB_LEASE_SECONDS=30
SLOT_LEASE_SECONDS=120
SCHEDULER_INTERVAL_SECONDS=5
WATCHDOG_INTERVAL_SECONDS=10
WATCHDOG_STALE_SECONDS=60
NODE_STALE_SECONDS=45
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=2
RESOURCE_SAMPLE_SECONDS=60

ORCHESTRATOR_PUBLIC_URL=http://127.0.0.1:8080
AGENT_PROTOCOL_VERSION=1
BACKGROUND_WORKERS=true

# Credential-free node cache mounted read-only during runtime bootstrap.
INCUS_RUNTIME_ASSETS=/var/lib/dst-orchestrator/runtime-assets/current
