ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8080
DATABASE_URL=sqlite:///.data/dst_orchestrator.sqlite3
RUNTIME_PROVIDER=mock
RUNTIME_VIEW_PROVIDER=disabled
VIEW_SESSION_TTL_SECONDS=300
RUNTIME_DISPLAY=:99

# Runtime-agent defaults are safe: automation is off until explicitly enabled.
WORKER_PLUGIN=noop
WORKER_MODE=DISABLED
WORKER_AUTOSTART=0
WORKER_CONFIG_SCHEMA_VERSION=1
RUNTIME_WORKER_PLUGIN=dst

# Generate a Fernet key with cryptography; dev creates .data/dev_master.key if empty.
DST_FARM_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_TTL_SECONDS=28800
DEBUG=false
AUTO_MIGRATE=true

INCUS_REMOTE=local
INCUS_BASE_INSTANCE=dst-base-v1
CURRENT_IMAGE_VERSION=dst-base-v1
INCUS_IMAGE=images:ubuntu/24.04
INCUS_PROFILE=default
INCUS_COMMAND_TIMEOUT_SECONDS=90
INCUS_MAX_ATTEMPTS=3

DEFAULT_NODE_NAME=local-node
DEFAULT_NODE_MAX_ACTIVE_SLOTS=2
DEFAULT_NODE_SECRET=

JOB_POLL_INTERVAL_SECONDS=1
JOB_LEASE_SECONDS=30
SLOT_LEASE_SECONDS=120
SCHEDULER_INTERVAL_SECONDS=5
WATCHDOG_INTERVAL_SECONDS=10
WATCHDOG_STALE_SECONDS=60
NODE_STALE_SECONDS=45
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=2
RESOURCE_SAMPLE_SECONDS=60

ORCHESTRATOR_PUBLIC_URL=http://127.0.0.1:8080
AGENT_PROTOCOL_VERSION=1
BACKGROUND_WORKERS=true
